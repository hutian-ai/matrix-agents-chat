# 复制到 .local/agent-host.env。此配置仅由外部宿主读取。
DOCK_CLIENT_COMMAND=harness-dock-client
DOCK_CLIENT_ARGS_JSON=[]
DOCK_CLIENT_CONFIG=.local/dock/client.json
DOCK_NODE_ID=""
DOCK_MODEL=""
DOCK_PROVIDER=codex
# 可选：此助手的回复要求；不构成工具权限隔离。
HOST_INSTRUCTIONS="请用简短中文回复消息，只生成文字，不执行工具或修改文件。"
# 仅接受这个人的消息；使用实际的完整 Matrix ID。
HOST_ALLOWED_SENDER=@human:example.org
