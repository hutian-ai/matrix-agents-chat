{
  "name": "@hutian-ai/matrix-agents-chat",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "基于 Matrix 的人和 Agent 通信 SDK：房间、成员、消息、历史与断线补收",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "pnpm web",
    "synapse:start": "../infra/postgres/manage.sh docker compose --env-file .local/synapse.env -f compose.local.yaml up -d --wait",
    "synapse:stop": "../infra/postgres/manage.sh docker compose --env-file .local/synapse.env -f compose.local.yaml stop",
    "synapse:status": "../infra/postgres/manage.sh docker compose --env-file .local/synapse.env -f compose.local.yaml ps",
    "matrix:login": "node --import tsx src/login.ts",
    "matrix:login:peer": "node --import tsx src/login.ts --peer",
    "matrix:room": "node --import tsx src/room-cli.ts",
    "chat": "node --import tsx src/message-cli.ts",
    "agent": "node --import tsx examples/dock-host.ts",
    "web": "pnpm web:build && node --import tsx examples/web/server.ts",
    "web:build": "vite build --config examples/web/vite.config.ts",
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "local:setup": "node --import tsx scripts/local-stack.ts setup",
    "local:up": "node --import tsx scripts/local-stack.ts up",
    "local:stop": "node --import tsx scripts/local-stack.ts stop",
    "local:status": "node --import tsx scripts/local-stack.ts status",
    "local:doctor": "node --import tsx scripts/local-stack.ts doctor",
    "doctor": "node --import tsx scripts/doctor.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "prepare": "husky",
    "lint:staged": "lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@harness-dock/client": "https://github.com/hutian-ai/harness-dock/releases/download/sdk-v0.1.2/harness-dock-sdk-0.1.2.tgz",
    "@types/node": "24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-vue": "6.0.10",
    "c12": "3.3.4",
    "citty": "0.2.2",
    "envalid": "9.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.11.0",
    "h3": "2.0.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.6",
    "proper-lockfile": "4.1.2",
    "srvx": "1.0.8",
    "tinyexec": "1.3.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.5",
    "vue": "3.5.44",
    "vue-eslint-parser": "10.4.2",
    "write-file-atomic": "7.0.1"
  },
  "dependencies": {
    "matrix-js-sdk": "45.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hutian-ai/matrix-agents-chat.git"
  },
  "homepage": "https://github.com/hutian-ai/matrix-agents-chat#readme",
  "keywords": [
    "matrix",
    "agents",
    "chat",
    "synapse",
    "harness-dock"
  ]
}
